{
  "name": "sisaket-gecc",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/preview.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.js",
    "db:migrate": "node server/manage.js migrate",
    "account:create": "node server/manage.js account",
    "accounts:prepare": "node server/accounts.js prepare var/private/accounts.json",
    "accounts:check": "node server/accounts.js check var/private/accounts.json",
    "accounts:apply": "node server/accounts.js apply var/private/accounts.json",
    "check:production": "node server/check-production.js",
    "build:php": "node deploy/build-php.mjs",
    "test:php": "node tests/php-integration.js",
    "data:import": "node server/manage.js import",
    "test:content": "node tests/public-features-browser.js"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "axe-core": "^4.11.0",
    "playwright": "^1.56.1"
  }
}
